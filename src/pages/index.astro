---
import Base from '../layouts/Base.astro';
import { getAllPosts } from '../lib/wp';

const posts = await getAllPosts();
const interrogatives = ['Who', 'What', 'Where', 'When', 'Why', 'How'];

// CDN/browser caching gives us ISR-like behaviour on this SSR route.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=900, stale-while-revalidate=3600');
---

<Base
  title="HouseSmart.ca — Construction Innovation Blueprints"
  description="Daily construction and home-building news, decoded into practical Jobs-To-Be-Done blueprints with tools, conditions, and field-tested fixes."
>
  <!-- BEAT 1 · W — establishing shot, 3:1 cinema frame, graded still, flood on the type side -->
  <div class="mx-auto max-w-[1200px] px-8 mt-12">
    <div class="banner graded" data-r>
      <div class="media" style="background-image:url('https://images.unsplash.com/photo-1542642839-83adadcbe645?q=80&w=2400&auto=format&fit=crop')"></div>
      <div class="flood"></div>
      <div class="cap py-12">
        <div class="eyebrow" style="color:rgba(245,247,250,.8)">Field notes, not fluff</div>
        <h1 class="hero-title mt-4">Construction news, decoded into blueprints you can act on.</h1>
        <a href="#feed" class="btn pill mt-7 inline-block">Browse the feed</a>
      </div>
    </div>
  </div>

  <!-- BEAT 2 · R — asymmetric proof rail: copy 1–10, stats 10–13 -->
  <section class="mx-auto max-w-[1200px] px-8 mt-32">
    <div class="grid grid-cols-6 lg:grid-cols-12 gap-8">
      <div class="col-span-6 lg:col-span-9">
        <div class="eyebrow accent" data-r>The engine</div>
        <h2 class="h2 mt-4 max-w-[800px]" data-r>Every story runs through a 216-node morphological matrix.</h2>
        <p class="mt-6 text-[18px] text-heading max-w-[620px]" data-r>
          Interrogative × relational × scale. The machine reads the news; the matrix finds the angle a site supervisor would actually use. You get the job, the conditions, and the fix — up front.
        </p>
      </div>
      <div class="col-span-6 lg:col-span-3 grid gap-8 content-end">
        <div class="stat" data-r style="transition-delay:150ms"><div class="v">216</div><div class="l eyebrow">Matrix alternatives</div></div>
        <div class="stat" data-r style="transition-delay:250ms"><div class="v">6×6×6</div><div class="l eyebrow">Axes per job</div></div>
      </div>
    </div>
  </section>

  <!-- BEAT 3 · V — the breath. Backlit stat band between hairlines. -->
  <section class="mx-auto max-w-[1200px] px-8 mt-48">
    <div class="statband" data-r>
      <div class="stat"><div class="v">{posts.length}</div><div class="l eyebrow">Live blueprints</div></div>
      <div class="stat"><div class="v">5</div><div class="l eyebrow">Feeds read daily</div></div>
      <div class="stat"><div class="v">400–700</div><div class="l eyebrow">Words, zero filler</div></div>
    </div>
  </section>

  <!-- BEAT 4 · G — the feed. Search + interrogative filter, cards on the surface tone. -->
  <section id="feed" class="mx-auto max-w-[1200px] px-8 mt-32 scroll-mt-24">
    <div class="eyebrow" data-r>The catalogue</div>
    <h2 class="h2 mt-4" data-r>Latest innovations</h2>

    <div class="mt-10 flex flex-col lg:flex-row lg:items-center gap-5" data-r>
      <input
        id="search"
        type="search"
        placeholder="Search — try concrete, air sealing, prefab"
        class="field lg:max-w-[420px]"
        autocomplete="off"
      />
      <div class="flex flex-wrap gap-2" id="filters" role="group" aria-label="Filter by interrogative">
        <button data-filter="" class="filter-chip active" aria-pressed="true">All</button>
        {interrogatives.map((i) => (
          <button data-filter={i} class="filter-chip" aria-pressed="false">{i}</button>
        ))}
      </div>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => (
        <article
          class="feed-card card-rp p-7 flex flex-col"
          data-r
          style={`transition-delay:${(i % 3) * 100}ms`}
          data-search={`${post.title} ${post.meta_description} ${post.tools_resources.join(' ')} ${post.action} ${post.object}`.toLowerCase()}
          data-interrogative={post.morphological_node.interrogative}
        >
          <div class="eyebrow">
            {post.morphological_node.interrogative} → {post.morphological_node.relational} → {post.morphological_node.scale}
          </div>
          <h3 class="h4 mt-3.5 !leading-snug">
            <a href={`/jtbd/${post.slug}`} class="no-underline text-heading transition-colors hover:text-accent-hover">
              {post.title}
            </a>
          </h3>
          <p class="mt-3 text-[15px] flex-1" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
            {post.meta_description}
          </p>
          <div class="mt-6 pt-4 border-t flex items-center justify-between" style="border-color:var(--hairline-soft)">
            <time datetime={post.date} class="eyebrow !text-[10px]">
              {new Date(post.date).toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <a href={`/jtbd/${post.slug}`} class="btn-ghost !text-[13px]">Read the blueprint</a>
          </div>
        </article>
      ))}
    </div>

    <p id="no-results" class="hidden text-center text-muted py-20">
      Nothing matches that search. Try a broader term — the feed updates daily.
    </p>
  </section>

  <!-- BEAT 5 · C — the cut. One blue scene, at the conversion point, last beat before the footer. -->
  <div class="cut mt-48">
    <div class="mx-auto max-w-[1200px] px-8 flex flex-wrap items-end justify-between gap-8">
      <h2 class="h2 max-w-[680px]" data-r>Not a news feed. A library you build.</h2>
      <a href="/signup" class="btn-invert" data-r>Start saving blueprints →</a>
    </div>
  </div>
</Base>

<style>
  .hero-title {
    font-size: clamp(34px, 4.4vw, 60px);
    letter-spacing: -0.04em;
    line-height: 1.05;
    font-weight: 600;
    color: #fff; /* pure-white exception: type sitting on imagery */
    max-width: 720px;
  }
  .filter-chip {
    font-size: 12px;
    letter-spacing: var(--track-micro);
    text-transform: uppercase;
    color: var(--color-muted);
    background: transparent;
    border: 1px solid var(--hairline-soft);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    transition: border-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  .filter-chip:hover { border-color: var(--hairline); color: var(--color-heading); }
  .filter-chip.active { color: var(--color-heading); border-color: var(--hairline); background: var(--color-surface2); }
</style>

<script>
  // Instant client-side search + interrogative filter over the rendered feed.
  const search = document.getElementById('search') as HTMLInputElement;
  const cards = [...document.querySelectorAll<HTMLElement>('.feed-card')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter-chip')];
  const empty = document.getElementById('no-results')!;
  let activeFilter = '';

  function apply() {
    const term = search.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const matchesTerm = !term || (card.dataset.search || '').includes(term);
      const matchesFilter = !activeFilter || card.dataset.interrogative === activeFilter;
      const show = matchesTerm && matchesFilter;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    empty.classList.toggle('hidden', visible > 0);
  }

  search.addEventListener('input', apply);
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeFilter = chip.dataset.filter || '';
      chips.forEach((c) => {
        const active = c === chip;
        c.classList.toggle('active', active);
        c.setAttribute('aria-pressed', String(active));
      });
      apply();
    });
  });
</script>
