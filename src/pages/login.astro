---
import Base from '../layouts/Base.astro';

const error = Astro.url.searchParams.get('error');
const sent = Astro.url.searchParams.get('sent') === '1';
const next = Astro.url.searchParams.get('next') || '/dashboard/saved';
---

<Base title="Log in | HouseSmart.ca">
  <div class="mx-auto max-w-[1200px] px-8">
    <div class="grid grid-cols-6 lg:grid-cols-12 gap-8 mt-24 mb-8">
      <div class="col-span-6 lg:col-start-4 lg:col-span-6 max-w-[480px]">
        <div class="eyebrow" data-r>Account</div>
        <h1 class="h2 mt-4" data-r>Welcome back.</h1>
        <p class="mt-4 text-[15px]" data-r>Log in to reach your saved innovation blueprints.</p>

        {error && (
          <p class="mt-8 border-l-2 pl-4 text-[14px] text-heading" style="border-color:var(--color-accent)" role="alert">{error}</p>
        )}
        {sent && (
          <p class="mt-8 border-l-2 pl-4 text-[14px] text-heading" style="border-color:var(--color-accent)" role="status">
            If that email has an account (or wants one), a login link is on its way. Valid for 15 minutes.
          </p>
        )}

        <form method="post" action="/api/auth/login" class="mt-10 space-y-6" data-r>
          <input type="hidden" name="next" value={next} />
          <input type="hidden" name="mode" value="password" />
          <div>
            <label for="email" class="field-label">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" class="field" placeholder="you@example.com" />
          </div>
          <div>
            <label for="password" class="field-label">Password</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" class="field" />
          </div>
          <button type="submit" class="btn w-full">Log in</button>
        </form>

        <div class="my-10 flex items-center gap-4">
          <span class="h-px flex-1" style="background:var(--hairline-soft)"></span>
          <span class="eyebrow">or</span>
          <span class="h-px flex-1" style="background:var(--hairline-soft)"></span>
        </div>

        <form method="post" action="/api/auth/login" data-r>
          <input type="hidden" name="mode" value="magic" />
          <label for="magic-email" class="field-label">Email me a magic login link</label>
          <div class="flex gap-3">
            <input id="magic-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="field flex-1" />
            <button type="submit" class="btn-secondary shrink-0">Send link</button>
          </div>
          <p class="eyebrow !text-[10px] mt-3">No password needed → new accounts created automatically</p>
        </form>

        <p class="mt-10 text-[14px] text-muted" data-r>
          No account? <a href="/signup" class="btn-ghost !text-[14px]">Sign up free</a>
        </p>
      </div>
    </div>
  </div>
</Base>
