---
import Base from '../layouts/Base.astro';

const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') || '/dashboard/saved';
---

<Base title="Sign up | HouseSmart.ca">
  <div class="mx-auto max-w-[1200px] px-8">
    <div class="grid grid-cols-6 lg:grid-cols-12 gap-8 mt-24 mb-8">
      <div class="col-span-6 lg:col-start-4 lg:col-span-6 max-w-[480px]">
        <div class="eyebrow" data-r>Account</div>
        <h1 class="h2 mt-4" data-r>Build your library.</h1>
        <p class="mt-4 text-[15px]" data-r>
          Save innovation blueprints and get new field-tested fixes by email — daily or weekly, your call.
        </p>

        {error && (
          <p class="mt-8 border-l-2 pl-4 text-[14px] text-heading" style="border-color:var(--color-accent)" role="alert">{error}</p>
        )}

        <form method="post" action="/api/auth/signup" class="mt-10 space-y-6" data-r>
          <input type="hidden" name="next" value={next} />
          <div>
            <label for="email" class="field-label">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" class="field" placeholder="you@example.com" />
          </div>
          <div>
            <label for="password" class="field-label">Password — 8+ characters</label>
            <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" class="field" />
          </div>
          <button type="submit" class="btn w-full">Create account</button>
        </form>

        <p class="mt-10 text-[14px] text-muted" data-r>
          Already have an account? <a href="/login" class="btn-ghost !text-[14px]">Log in</a>
          <span class="block mt-2">Prefer no password? The <a href="/login" class="text-heading no-underline hover:text-accent-hover transition-colors">magic link</a> works for signup too.</span>
        </p>
      </div>
    </div>
  </div>
</Base>
