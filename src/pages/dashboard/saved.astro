---
import Base from '../../layouts/Base.astro';
import { getBookmarks, getCurrentUser } from '../../lib/auth-bookmarks';

const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/login?next=/dashboard/saved', 303);
}

const bookmarks = await getBookmarks(user.id);
const prefsSaved = Astro.url.searchParams.get('prefs') === 'saved';
---

<Base title="Your Saved Blueprints | HouseSmart.ca" description="Manage your saved innovation blueprints and notification preferences.">
  <div class="mx-auto max-w-[1200px] px-8">
    <!-- R — the library header, left rail with the filter on the right -->
    <div class="mt-20 flex flex-wrap items-end justify-between gap-6">
      <div>
        <div class="eyebrow" data-r>Your library</div>
        <h1 class="h2 mt-4" data-r>Saved blueprints</h1>
        <p class="eyebrow mt-4" data-r>{user.email} → {bookmarks.length} saved</p>
      </div>
      <input
        id="bookmark-search"
        type="search"
        placeholder="Filter your saves"
        class="field !w-auto min-w-[260px]"
        autocomplete="off"
        data-r
      />
    </div>

    {bookmarks.length === 0 ? (
      <div class="mt-16 rounded-3xl border border-dashed p-16 text-center" style="border-color:var(--hairline)" data-r>
        <h2 class="h4">Nothing saved yet</h2>
        <p class="mt-2 text-[15px] text-muted">Hit "Save innovation" on any blueprint and it lands here.</p>
        <a href="/" class="btn-secondary pill mt-8 inline-block">Browse innovations</a>
      </div>
    ) : (
      <ul id="bookmark-list" class="mt-14 list-none p-0 m-0 border-t" style="border-color:var(--hairline-soft)">
        {bookmarks.map((bookmark, i) => (
          <li
            class="bookmark-row flex items-center gap-6 py-6 border-b"
            style={`border-color:var(--hairline-soft);transition-delay:${Math.min(i, 5) * 60}ms`}
            data-r
            data-search={`${bookmark.jtbd_title} ${bookmark.matrix_node || ''}`.toLowerCase()}
          >
            <span class="text-accent hidden sm:block" aria-hidden="true">→</span>
            <div class="flex-1 min-w-0">
              <a href={`/jtbd/${bookmark.jtbd_slug}`} class="h4 !text-[19px] no-underline transition-colors hover:!text-accent-hover">
                {bookmark.jtbd_title}
              </a>
              <p class="eyebrow !text-[10px] mt-1.5">
                {bookmark.matrix_node && <span>{bookmark.matrix_node} · </span>}
                Saved {new Date(bookmark.saved_at).toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric' })}
              </p>
            </div>
            <button
              type="button"
              class="remove-bookmark eyebrow cursor-pointer bg-transparent border-0 p-0 shrink-0 transition-colors hover:!text-heading"
              data-id={bookmark.jtbd_id}
              data-slug={bookmark.jtbd_slug}
              data-title={bookmark.jtbd_title}
            >
              Remove
            </button>
          </li>
        ))}
      </ul>
    )}

    <!-- W — preferences on a backlit panel -->
    <section class="mt-32 mb-8 rounded-3xl border p-8 sm:p-12" style="background:var(--color-surface);border-color:var(--hairline-soft);background-image:var(--backlight-top)" data-r>
      <div class="eyebrow accent">Email updates</div>
      <h2 class="h3 mt-3.5">New blueprints, in your inbox.</h2>
      <p class="mt-3 text-[15px] max-w-[520px]">The RSS engine publishes daily. Pick how often the digest lands.</p>
      {prefsSaved && <p class="mt-4 text-[14px] text-heading" role="status">Preference saved →</p>}
      <form method="post" action="/api/preferences" class="mt-7 flex flex-wrap items-center gap-3">
        {(['none', 'daily', 'weekly'] as const).map((option) => (
          <label class:list={['digest-pill', user.email_digest === option && 'active']}>
            <input type="radio" name="email_digest" value={option} checked={user.email_digest === option} class="sr-only" />
            {option === 'none' ? 'Off' : option === 'daily' ? 'Daily digest' : 'Weekly digest'}
          </label>
        ))}
        <button type="submit" class="btn sm !ml-2">Save preference</button>
      </form>
    </section>
  </div>
</Base>

<style>
  .digest-pill {
    cursor: pointer;
    font: 600 13px var(--font-sans);
    color: var(--color-muted);
    border: 1px solid var(--hairline-soft);
    border-radius: 999px;
    padding: 9px 20px;
    transition: border-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  .digest-pill:hover { border-color: var(--hairline); color: var(--color-heading); }
  .digest-pill.active { color: var(--color-heading); border-color: var(--hairline); background: var(--color-surface2); }
</style>

<script>
  // Instant filter
  const search = document.getElementById('bookmark-search') as HTMLInputElement | null;
  const rows = [...document.querySelectorAll<HTMLElement>('.bookmark-row')];
  search?.addEventListener('input', () => {
    const term = search.value.trim().toLowerCase();
    rows.forEach((row) => {
      row.style.display = !term || (row.dataset.search || '').includes(term) ? '' : 'none';
    });
  });

  // Remove = toggle off via the same endpoint, then drop the row.
  document.querySelectorAll<HTMLButtonElement>('.remove-bookmark').forEach((button) => {
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        const res = await fetch('/api/bookmarks', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jtbd_id: button.dataset.id,
            jtbd_slug: button.dataset.slug,
            jtbd_title: button.dataset.title,
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        button.closest('li')?.remove();
      } catch {
        button.disabled = false;
        button.textContent = 'Retry';
      }
    });
  });
</script>
