---
import Base from '../../layouts/Base.astro';
import { getBookmarks, getCurrentUser } from '../../lib/auth-bookmarks';

const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/login?next=/dashboard/saved', 303);
}

const bookmarks = await getBookmarks(user.id);
const prefsSaved = Astro.url.searchParams.get('prefs') === 'saved';
---

<Base title="Your Saved Blueprints | HomeSmart.ca" description="Manage your saved innovation blueprints and notification preferences.">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-10">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-black tracking-tight text-brand-950">Saved Blueprints</h1>
        <p class="text-slate-500 text-sm mt-1">{user.email} · {bookmarks.length} saved</p>
      </div>
      <input
        id="bookmark-search"
        type="search"
        placeholder="Filter your saves..."
        class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
        autocomplete="off"
      />
    </div>

    {bookmarks.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center">
        <p class="text-4xl mb-3">📐</p>
        <h2 class="font-bold text-brand-950 text-lg">Nothing saved yet</h2>
        <p class="text-slate-500 text-sm mt-1 mb-5">Hit "Save Innovation" on any blueprint and it lands here.</p>
        <a href="/" class="inline-block bg-brand-900 hover:bg-brand-800 text-white font-semibold text-sm px-5 py-2.5 rounded-lg transition-colors">
          Browse innovations
        </a>
      </div>
    ) : (
      <ul id="bookmark-list" class="space-y-3">
        {bookmarks.map((bookmark) => (
          <li
            class="bookmark-row rounded-xl border border-slate-200 bg-white p-4 flex items-center gap-4 hover:border-brand-400 transition-colors"
            data-search={`${bookmark.jtbd_title} ${bookmark.matrix_node || ''}`.toLowerCase()}
          >
            <div class="flex-1 min-w-0">
              <a href={`/jtbd/${bookmark.jtbd_slug}`} class="font-semibold text-brand-950 hover:text-brand-600 transition-colors">
                {bookmark.jtbd_title}
              </a>
              <p class="text-xs text-slate-400 mt-0.5">
                {bookmark.matrix_node && <span class="font-medium text-violet-600">{bookmark.matrix_node}</span>}
                {bookmark.matrix_node && ' · '}
                Saved {new Date(bookmark.saved_at).toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric' })}
              </p>
            </div>
            <button
              type="button"
              class="remove-bookmark shrink-0 text-xs font-semibold text-slate-400 hover:text-red-600 transition-colors"
              data-id={bookmark.jtbd_id}
              data-slug={bookmark.jtbd_slug}
              data-title={bookmark.jtbd_title}
            >
              Remove
            </button>
          </li>
        ))}
      </ul>
    )}

    <!-- Notification preferences -->
    <section class="mt-12 rounded-2xl border border-slate-200 bg-white p-6">
      <h2 class="font-bold text-brand-950 text-lg mb-1">Email updates</h2>
      <p class="text-sm text-slate-500 mb-4">Get new innovation blueprints from the RSS engine in your inbox.</p>
      {prefsSaved && <p class="text-sm text-emerald-600 font-medium mb-3" role="status">✓ Preference saved.</p>}
      <form method="post" action="/api/preferences" class="flex flex-wrap items-center gap-3">
        {(['none', 'daily', 'weekly'] as const).map((option) => (
          <label class:list={[
            'cursor-pointer rounded-lg px-4 py-2 text-sm font-semibold ring-1 transition-colors',
            user.email_digest === option
              ? 'bg-brand-900 text-white ring-brand-900'
              : 'bg-white text-slate-700 ring-slate-300 hover:ring-brand-500',
          ]}>
            <input type="radio" name="email_digest" value={option} checked={user.email_digest === option} class="sr-only" />
            {option === 'none' ? 'Off' : option === 'daily' ? 'Daily digest' : 'Weekly digest'}
          </label>
        ))}
        <button type="submit" class="bg-accent-500 hover:bg-accent-400 text-brand-950 font-bold text-sm px-5 py-2 rounded-lg transition-colors">
          Save preference
        </button>
      </form>
    </section>
  </div>
</Base>

<script>
  // Instant filter
  const search = document.getElementById('bookmark-search') as HTMLInputElement | null;
  const rows = [...document.querySelectorAll<HTMLElement>('.bookmark-row')];
  search?.addEventListener('input', () => {
    const term = search.value.trim().toLowerCase();
    rows.forEach((row) => {
      row.style.display = !term || (row.dataset.search || '').includes(term) ? '' : 'none';
    });
  });

  // Remove = toggle off via the same endpoint, then drop the row.
  document.querySelectorAll<HTMLButtonElement>('.remove-bookmark').forEach((button) => {
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        const res = await fetch('/api/bookmarks', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jtbd_id: button.dataset.id,
            jtbd_slug: button.dataset.slug,
            jtbd_title: button.dataset.title,
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        button.closest('li')?.remove();
      } catch {
        button.disabled = false;
        button.textContent = 'Retry';
      }
    });
  });
</script>
