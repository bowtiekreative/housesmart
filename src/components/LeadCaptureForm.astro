---
/**
 * Consultation form — a backlit surface panel at 24px radius. Hairline
 * fields, one primary button, one open question. Posts to /api/leads.
 */
interface Props {
  jtbdSlug?: string;
  heading?: string;
}

const {
  jtbdSlug = '',
  heading = 'Want this done on your project?',
} = Astro.props;
---

<section
  id="consult"
  class="rounded-3xl border p-8 sm:p-12"
  style="background:var(--color-surface);border-color:var(--hairline-soft);background-image:var(--backlight-top)"
>
  <div class="eyebrow accent">Vendor match</div>
  <h2 class="h3 mt-3.5">{heading}</h2>
  <p class="mt-3 text-[15px] max-w-[560px]">
    Tell us what you're building. We match you with a vetted vendor partner who has done this exact job — no call-centre runaround.
  </p>

  <form method="post" action="/api/leads" data-lead-form class="mt-8 grid gap-6 sm:grid-cols-2">
    <input type="hidden" name="jtbd_slug" value={jtbdSlug} />
    <div>
      <label for="lead-name" class="field-label">Name</label>
      <input id="lead-name" name="name" required autocomplete="name" class="field" placeholder="Jamie Tremblay" />
    </div>
    <div>
      <label for="lead-email" class="field-label">Email</label>
      <input id="lead-email" name="email" type="email" required autocomplete="email" class="field" placeholder="you@example.com" />
    </div>
    <div>
      <label for="lead-phone" class="field-label">Phone — optional</label>
      <input id="lead-phone" name="phone" type="tel" autocomplete="tel" class="field" placeholder="(555) 555-0100" />
    </div>
    <div>
      <label for="lead-project" class="field-label">Project type</label>
      <select id="lead-project" name="project" class="field">
        <option value="new-build">New build</option>
        <option value="renovation">Renovation</option>
        <option value="addition">Addition</option>
        <option value="repair">Repair / retrofit</option>
        <option value="other">Something else</option>
      </select>
    </div>
    <div class="sm:col-span-2">
      <label for="lead-message" class="field-label">What are you trying to get done?</label>
      <textarea id="lead-message" name="message" rows="3" class="field"
        placeholder="1,800 sq ft bungalow, rim joists sealed before insulation inspection in October"></textarea>
    </div>
    <div class="sm:col-span-2 flex items-center gap-5 flex-wrap">
      <button type="submit" class="btn">Request a consult</button>
      <p data-lead-status class="hidden text-[14px] m-0" role="status"></p>
    </div>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-lead-status]')!;
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      button.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = 'Got it → a vendor partner will reach out within one business day.';
        status.style.color = 'var(--color-heading)';
        status.classList.remove('hidden');
      } catch {
        status.textContent = 'Something went wrong — try again or email hello@housesmart.ca.';
        status.style.color = 'var(--color-muted)';
        status.classList.remove('hidden');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
