---
interface Props {
  user: { email: string } | null;
}
const { user } = Astro.props;
const path = Astro.url.pathname;
const siteName = "HouseSmart";
const siteDomain = ".ca";
---

<header
  class="sticky top-0 z-50 border-b"
  style="background:var(--glass-bg);backdrop-filter:var(--glass-blur);-webkit-backdrop-filter:var(--glass-blur);border-color:var(--hairline-soft)"
>
  <div class="mx-auto max-w-[1200px] px-8 h-[72px] flex items-center justify-between gap-6">
    <!-- 1 — seal, 2 — uppercase site name -->
    <a href="/" class="flex items-center gap-3 no-underline min-h-[44px]" aria-label="HouseSmart.ca — home">
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" focusable="false" class="flex-none text-heading">
        <circle cx="14" cy="14" r="13" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.35" />
        <text x="14" y="18" text-anchor="middle" font-size="12" font-weight="600" fill="currentColor">H</text>
      </svg>
      <span class="text-[18px] font-semibold tracking-[0.02em] text-heading leading-none">
        HOUSESMART<span class="text-muted">.CA</span>
      </span>
    </a>

    <!-- 3 — Menu button (only if user is logged in), 4 — CTA -->
    <div class="flex items-center gap-4">
      <nav class="flex items-center gap-7">
        <a
          href="/"
          class:list={['eyebrow transition-colors hover:!text-heading', path === '/' && '!text-heading']}
        >
          Innovations
        </a>
        {user ? (
          <>
            <a
              href="/dashboard/saved"
              class:list={['eyebrow transition-colors hover:!text-heading', path.startsWith('/dashboard') && '!text-heading']}
            >
              Saved
            </a>
            <form method="post" action="/api/auth/logout" class="m-0 hidden sm:block">
              <button type="submit" class="eyebrow cursor-pointer bg-transparent border-0 p-0 transition-colors hover:!text-heading">
                Log out
              </button>
            </form>
          </>
        ) : (
          <>
            <a href="/login" class="eyebrow transition-colors hover:!text-heading hidden sm:inline">Log in</a>
          </>
        )}
      </nav>
      <a href="/signup" class="btn sm" style="border-radius:999px">Sign up</a>
    </div>
  </div>
</header>