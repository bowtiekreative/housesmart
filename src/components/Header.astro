---
interface Props {
  user: { email: string } | null;
}
const { user } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Innovations' },
  { href: '/#consult', label: 'Get a Consult' },
];
---

<header class="sticky top-0 z-40 bg-brand-950/95 backdrop-blur border-b border-brand-800">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2.5 group">
      <span class="grid place-items-center w-9 h-9 rounded-lg bg-accent-500 text-brand-950 font-black text-lg group-hover:bg-accent-400 transition-colors">H</span>
      <span class="text-white font-bold text-lg tracking-tight">
        HouseSmart<span class="text-accent-400">.ca</span>
      </span>
    </a>

    <nav class="hidden sm:flex items-center gap-6">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-medium transition-colors',
            path === item.href ? 'text-accent-400' : 'text-brand-100 hover:text-white',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      {user ? (
        <>
          <a
            href="/dashboard/saved"
            class:list={[
              'text-sm font-medium transition-colors',
              path.startsWith('/dashboard') ? 'text-accent-400' : 'text-brand-100 hover:text-white',
            ]}
          >
            Saved
          </a>
          <form method="post" action="/api/auth/logout">
            <button type="submit" class="text-sm text-brand-300 hover:text-white transition-colors">
              Log out
            </button>
          </form>
        </>
      ) : (
        <>
          <a href="/login" class="text-sm font-medium text-brand-100 hover:text-white transition-colors">Log in</a>
          <a
            href="/signup"
            class="text-sm font-semibold bg-accent-500 hover:bg-accent-400 text-brand-950 px-3.5 py-1.5 rounded-lg transition-colors"
          >
            Sign up
          </a>
        </>
      )}
    </div>
  </div>
</header>
