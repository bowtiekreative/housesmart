---
/**
 * One node of the 6×6×6 morphological matrix as hairline pills with literal
 * → arrows between the axes — the copy's transformation grammar, not colour.
 */
import type { MorphologicalNode } from '../lib/wp';

interface Props {
  node: MorphologicalNode;
  showConcept?: boolean;
}

const { node, showConcept = false } = Astro.props;
const axes = [
  { label: 'Interrogative', value: node.interrogative },
  { label: 'Relational', value: node.relational },
  { label: 'Scale', value: node.scale },
];
---

<div>
  <div
    class="flex flex-wrap items-center gap-2"
    title={`Matrix node: ${node.interrogative} × ${node.relational} × ${node.scale} — 1 of 216`}
  >
    {axes.map((axis, i) => (
      <>
        {i > 0 && <span class="text-muted text-[13px]" aria-hidden="true">→</span>}
        <span class="badge-rp">
          <span class="sr-only">{axis.label}:</span>
          {axis.value}
        </span>
      </>
    ))}
    <span class="eyebrow ml-2 !text-[10px]">Node 1 of 216</span>
  </div>
  {showConcept && node.solution_concept && (
    <p class="mt-4 pl-5 border-l text-[15px] text-body max-w-[560px]" style="border-color:var(--hairline)">
      {node.solution_concept}
    </p>
  )}
</div>
