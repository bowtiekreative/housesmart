---
import BrandSeal from './BrandSeal.astro';
const year = new Date().getFullYear();
---

<footer class="mt-32 border-t py-10" style="border-color:var(--hairline-soft)">
  <div class="mx-auto max-w-[1200px] px-8 flex flex-wrap justify-between gap-6 text-[13px] text-muted">
    <div class="footer-brand">
      <a href="/" class="footer-identity" aria-label="HouseSmart.ca home">
        <BrandSeal />
        <span>HOUSE<strong>SMART.CA</strong></span>
      </a>
      <div class="eyebrow mt-1.5">Construction news → practical blueprints</div>
    </div>
    <nav class="flex flex-wrap items-start gap-x-7 gap-y-2">
      <a href="/" class="hover:text-heading transition-colors no-underline text-muted">Innovations</a>
      <a href="/dashboard/saved" class="hover:text-heading transition-colors no-underline text-muted">Saved blueprints</a>
      <a href="/login" class="hover:text-heading transition-colors no-underline text-muted">Log in</a>
      <a href="/signup" class="hover:text-heading transition-colors no-underline text-muted">Create an account</a>
    </nav>
    <div class="flex flex-wrap gap-x-4">
      <span>© {year} HouseSmart.ca · 216 matrix nodes · Fed daily</span>
      <span class="text-muted">
        · Powered by <a href="https://bowtiekreative.com" target="_blank" rel="noopener noreferrer" class="text-heading hover:text-accent-hover transition-colors no-underline">Bow Tie Kreative</a>
      </span>
    </div>
  </div>
</footer>
<style>
  .footer-brand{display:flex;flex-direction:column;align-items:flex-start}
  .footer-identity{display:inline-flex;align-items:center;gap:13px;color:var(--rp-heading);text-decoration:none;font-size:20px;font-weight:700;letter-spacing:.02em;line-height:1}
  .footer-identity strong{color:var(--rp-accent)}
</style>