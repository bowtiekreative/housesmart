---
/**
 * The innovation blueprint — a shadowless surface panel with hairline
 * dividers. Pre-conditions read as an accent arrow list, post-conditions as
 * a quiet one (never the same treatment twice), and the job itself is a
 * literal action → object → outcome line.
 */
import type { JtbdPost } from '../lib/wp';

interface Props {
  post: JtbdPost;
}

const { post } = Astro.props;
---

<section aria-label="Innovation blueprint" class="card-rp overflow-hidden !rounded-3xl">
  <div class="px-8 pt-7 pb-5 flex items-baseline justify-between gap-4 flex-wrap">
    <span class="eyebrow">The blueprint</span>
    <span class="eyebrow">
      {post.solution_status === 'Existing' ? 'Proven in the field' : 'Speculative concept'}
    </span>
  </div>

  {(post.action || post.object || post.outcome) && (
    <div class="px-8 pb-7">
      <p class="h4 !leading-snug max-w-[640px]">
        {post.action} <span class="text-accent">→</span> {post.object.toLowerCase().charAt(0) + post.object.slice(1)}
        <span class="text-accent">→</span> <span class="text-body font-normal">{post.outcome.toLowerCase().charAt(0) + post.outcome.slice(1)}</span>
      </p>
    </div>
  )}

  <div class="grid sm:grid-cols-2 border-t" style="border-color:var(--hairline-soft)">
    <div class="px-8 py-7 sm:border-r" style="border-color:var(--hairline-soft)">
      <h3 class="eyebrow mb-4">Before you start</h3>
      <ul class="alist">
        {post.pre_conditions.map((item) => (
          <li class="text-body">{item}</li>
        ))}
      </ul>
    </div>
    <div class="px-8 py-7 border-t sm:border-t-0" style="border-color:var(--hairline-soft)">
      <h3 class="eyebrow mb-4">When it's done right</h3>
      <ul class="alist quiet">
        {post.post_conditions.map((item) => (
          <li class="text-body">{item}</li>
        ))}
      </ul>
    </div>
  </div>

  {post.tools_resources.length > 0 && (
    <div class="px-8 py-6 border-t" style="border-color:var(--hairline-soft)">
      <h3 class="eyebrow mb-4">Tools & resources</h3>
      <div class="flex flex-wrap gap-2">
        {post.tools_resources.map((tool) => (
          <span class="badge-rp !normal-case !tracking-normal !text-[12px]">{tool}</span>
        ))}
      </div>
    </div>
  )}
</section>
