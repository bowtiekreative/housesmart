---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCurrentUser } from '../lib/auth-bookmarks';

interface Props {
  title: string;
  description?: string;
  jsonLd?: object | object[];
}

const { title, description = 'Construction and home-building innovations, decoded into practical blueprints.', jsonLd } = Astro.props;

let user = null;
try {
  user = await getCurrentUser(Astro.cookies);
} catch {
  // DB unavailable (e.g. local dev without Postgres) — render logged-out.
}
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HouseSmart.ca" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏠</text></svg>" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 flex flex-col">
    <Header user={user} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
