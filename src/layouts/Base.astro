---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCurrentUser } from '../lib/auth-bookmarks';

interface Props {
  title: string;
  description?: string;
  jsonLd?: object | object[];
}

const { title, description = 'Construction and home-building innovations, decoded into practical blueprints.', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/brand-social.png', Astro.site);
const defaultJsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'HouseSmart.ca', url: 'https://housesmart.ca', description };

let user = null;
try {
  user = await getCurrentUser(Astro.cookies);
} catch {
  // DB unavailable (e.g. local dev without Postgres) — render logged-out.
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HouseSmart.ca" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HouseSmart.ca — construction intelligence organized into practical blueprints" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content="HouseSmart.ca — construction intelligence organized into practical blueprints" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google tag (gtag.js) - GA4 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      gtag("js", new Date());
      gtag("config", "G-HOUSESMART", { send_page_view: false });
      gtag("event", "page_view", { page_path: location.pathname, page_location: location.href, page_title: document.title });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HOUSESMART"></script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? defaultJsonLd)} />
  </head>
  <body data-laka-version="4.3" class="min-h-screen bg-canvas text-body flex flex-col text-[16px] leading-[1.7]">
    <div class="atmo" aria-hidden="true"><i></i><i></i></div>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header user={user} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // L8 — reveal on entry, animate off on exit. The page performs in both directions.
      const els = [...document.querySelectorAll<HTMLElement>('[data-r]')];
      const motionEnabled = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (motionEnabled && els.length) document.documentElement.classList.add('js');
      else els.forEach((el) => el.classList.add('in'));
      let raf = 0;
      function check() {
        const vh = window.innerHeight || 800;
        for (const el of els) {
          const r = el.getBoundingClientRect();
          if (r.top < vh * 0.92 && r.bottom > vh * 0.04) { el.classList.add('in'); el.classList.remove('above'); }
          else if (r.bottom <= vh * 0.04) { el.classList.remove('in'); el.classList.add('above'); }
          else { el.classList.remove('in', 'above'); }
        }
      }
      function onScroll() { cancelAnimationFrame(raf); raf = requestAnimationFrame(check); }
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
      check();
      setTimeout(check, 250);
    </script>
  </body>
</html>
