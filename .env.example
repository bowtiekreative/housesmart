# ── DeepSeek AI Processing Engine ────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Headless WordPress ───────────────────────────────────────────
# WP_AUTH_KEY = "username:application-password" (WP Admin → Users →
# Profile → Application Passwords). Used by the RSS processor to publish.
WP_URL=https://cms.homesmart.ca
WP_AUTH_KEY=homesmart-bot:xxxx xxxx xxxx xxxx xxxx xxxx

# ── PostgreSQL (auth, bookmarks, leads) ──────────────────────────
DATABASE_URL=postgres://homesmart:homesmart@localhost:5432/homesmart

# ── Site ─────────────────────────────────────────────────────────
SITE_URL=https://homesmart.ca

# ── RSS ingestion ────────────────────────────────────────────────
# Comma-separated feed URLs (optional — sensible defaults built in)
RSS_FEEDS=
MAX_ITEMS_PER_RUN=5
RSS_INTERVAL_MINUTES=360

# ── Email (magic links, digests, lead notifications) ─────────────
# Leave SMTP_HOST empty in dev: mail is printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HomeSmart.ca <no-reply@homesmart.ca>
LEADS_NOTIFY_EMAIL=

# ── Supabase (optional alternative auth backend — unused when
#    DATABASE_URL/Postgres auth is active) ────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── docker-compose only ──────────────────────────────────────────
POSTGRES_PASSWORD=change-me
WP_DB_PASSWORD=change-me-too
